<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景：终端提示符 "❯ _"。
  108x108 画布中，安全区是中间 72x72（即 18..90），图形都画在安全区内，
  这样被圆形/方形/圆角矩形等各种启动器遮罩裁剪时都不会缺角。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左箭头 ❯ -->
    <path
        android:pathData="M38,38 L54,54 L38,70"
        android:strokeColor="#66BB6A"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 下划线 _ -->
    <path
        android:pathData="M60,70 L74,70"
        android:strokeColor="#ECEFF1"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

</vector>
